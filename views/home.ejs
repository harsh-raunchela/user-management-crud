<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delta — Home</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page">

    <header class="site-header">
      <a href="/" class="brand">
        <svg class="brand-mark" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 6 C21 6 21.6 6.6 22 7.4 L34.5 30.6 C35.3 32.1 34.2 34 32.4 34 H7.6 C5.8 34 4.7 32.1 5.5 30.6 L18 7.4 C18.4 6.6 19 6 20 6 Z"
            stroke="#241F1A" stroke-width="2.4" stroke-linejoin="round" fill="#FFC93C"/>
        </svg>
        ADDA
      </a>
      <nav class="nav">
        <a href="/">Home</a>
        <a href="/user">People</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <h1>The people of <span data-rn="underline" data-rn-color="#FF5D73">Delta</span></h1>
        <p>A small, hand-kept record of everyone who's joined. No spreadsheets, no fuss — just a sketchbook of names.</p>
        <p class="badge-count">
          <span data-rn="circle" data-rn-color="#4D96FF"><%= count %></span>&nbsp;people signed up so far
        </p>
        <div class="hero-actions">
          <a href="/user/new" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            Join us today
          </a>
          <a href="/user" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 19c0-4 3-5.5 5-5.5S14 15 14 19M12 8.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM15 13.2c1.6.3 3.5 1.6 3.5 5.8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Meet everyone
          </a>
        </div>
      </div>

      <svg class="hero-doodle" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="90" cy="90" r="70" stroke="#241F1A" stroke-width="2.4" stroke-dasharray="1 9" stroke-linecap="round"/>
        <circle cx="90" cy="72" r="26" stroke="#241F1A" stroke-width="2.6" fill="#FFF3E9"/>
        <path d="M48 148c4-26 20-38 42-38s38 12 42 38" stroke="#241F1A" stroke-width="2.6" stroke-linecap="round" fill="#FF5D73" fill-opacity="0.15"/>
        <path d="M132 40l7 7M139 33l-3 10" stroke="#4D96FF" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
    </section>

  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/rough-notation/0.5.1/rough-notation.iife.min.js"></script>
  <script src="/doodle.js"></script>
</body>
</html>
